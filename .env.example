# Copy to .env for the main `docker-compose.yml` dev stack.
# Test stacks (docker-compose.test-*.yml) use hardcoded throwaway
# credentials and do not read this file.

DEVMAIL_SMTP_USER=devmail
DEVMAIL_SMTP_PASSWORD=devmail

# Host ports published by docker-compose.yml.
#
# Port scheme: HTTP mirrors dbadmin's 8080/8081/8082 for dev/test-dev/
# test-prod. SMTPS host ports follow the same convention dbadmin used for
# postgres (default 5432 -> 55432/55433/55434, i.e. prefix a "5" and count
# up per stack): default 465 -> 5465/5466/5467.
#
#   stack       HTTP    SMTPS (loopback only)
#   dev         8080    127.0.0.1:5465
#   test-dev    8081    127.0.0.1:5466
#   test-prod   8082    127.0.0.1:5467
HTTP_HOST_PORT=8080
SMTP_HOST_PORT=5465

# Container-internal ports. These already match config.go's own defaults;
# override only if 80/465 clash with something else in the container's
# network namespace.
DEVMAIL_HTTP_PORT=80
DEVMAIL_SMTP_PORT=465
